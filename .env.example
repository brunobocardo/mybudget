# Copy this file to .env and fill in what you need. Never commit .env.

# Address you open in the browser. Must match the redirect URI in Google Cloud.
BASE_URL=http://localhost:8765

# --- Sign in with Google (leave empty to run without login) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
# Authorized redirect URI: http://localhost:8765/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed in, comma-separated
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# --- AI advice (optional) --- https://console.anthropic.com
ANTHROPIC_API_KEY=
